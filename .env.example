# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Voyage AI — turns text into vectors (embeddings) for ingest + search.
# Get a free key at https://www.voyageai.com
VOYAGE_API_KEY=

# OpenAI — powers the chatbot answers (GPT streams the reply).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase Postgres — stores document chunks + vectors (pgvector).
# Replace [YOUR-PASSWORD] with your DATABASE password (from project creation), NOT the project URL.
# SjefnBas project — Transaction pooler:
DATABASE_URL=postgresql://postgres.ikggvgtuaphmfjcyfbdd:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
